# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Will be used when you connect MongoDB)
# For local MongoDB: mongodb://127.0.0.1:27017/portfolio
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=

# Optional: Instant Email Notification on Contact Form Submissions
# (Leave empty if you only want to save to MongoDB/JSON)
EMAIL_USER=
EMAIL_PASS=
# Optional: recipient email if different from EMAIL_USER (defaults to poojawork1111@gmail.com)
NOTIFICATION_RECIPIENT=poojawork1111@gmail.com
# Optional: custom SMTP host/port (defaults to Gmail service)
SMTP_SERVICE=gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
